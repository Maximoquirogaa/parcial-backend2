# Configuración de base de datos PostgreSQL
POSTGRES_USER=usuario
POSTGRES_PASSWORD=contraseña_segura
POSTGRES_DB=libreria_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Seguridad y Autenticación JWT / Cookies
SECRET_KEY=clave_secreta_minimo_32_caracteres_hex_o_alfanumerica
TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false

# Parámetros de hash (Bcrypt)
BCRYPT_COST=12
BCRYPT_MAX_CONCURRENT=4

# Parámetros de conexión a la base de datos (Motor / Pool)
POOL_SIZE=5
SQL_ECHO=false
